    "interface": {
      "mode": "stdin_stdout",
      "signature": "stdin -> stdout",
      "input_channel": "stdin",
      "output_channel": "stdin"
    },
    "preconditions": [
      {
        "id": "P1",
        "expression": "1 <= n <= 100 and 1 <= m <= 100",
        "description": "The number of points (n) and segments (m) are within the specified bounds."
      },
      {
        "id": "P2",
        "expression": "all(0 <= x <= 100 for x in points) and len(points) == n",
        "description": "All point coordinates are integers between 0 and 100, and there are exactly n points."
      },
      {
        "id": "P3",
        "expression": "all(0 <= l <= r <= 100 for l, r in segments) and len(segments) == m",
        "description": "All segment bounds are integers with l ≤ r, and there are exactly m segments."
      },
      {
        "id": "P4",
        "expression": "len(set(points)) == n",
        "description": "All points are distinct."
      }
    ],
    "postconditions": [
      {
        "id": "Q1",
        "expression": "stdout == '-1' or (len(output) == n and all(c in {0, 1} for c in output))",
        "description": "If no good drawing exists, output is '-1'; otherwise, output is a list of n integers (0 or 1) representing the color of each point."
      },
      {
        "id": "Q2",
        "expression": "stdout != '-1' implies all(abs(red_in_segment - blue_in_segment) <= 1 for segment in segments for red_in_segment, blue_in_segment in [(sum(1 for i, x in enumerate(points) if segment[0] <= x <= segment[1] and output[i] == 0), sum(1 for i, x in enumerate(points) if segment[0] <= x <= segment[1] and output[i] == 1))])",
        "description": "For every segment, the absolute difference between the number of red points and blue points within it is at most 1."
      }
    ],
    "invariants": []
  },
