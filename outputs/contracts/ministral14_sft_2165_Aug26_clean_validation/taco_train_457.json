        "expression": "all(1 <= x <= n for x in s) and len(s) == n and len(set(s)) == n",
        "description": "s is a permutation of numbers from 1 to n."
      }
    ],
    "postconditions": [
      {
        "id": "Q1",
        "expression": "stdout.splitlines()[0].isdigit() and int(stdout.splitlines()[0]) >= 0",
        "description": "The first line of stdout is a non-negative integer representing the minimum total coins required."
      },
      {
        "id": "Q2",
        "expression": "k_line := stdout.splitlines()[1]; k_line.isdigit() and 0 <= int(k_line) <= 2000000",
        "description": "The second line of stdout is a non-negative integer k (0 ≤ k ≤ 2·10^6) representing the number of swap operations."
      },
      {
        "id": "Q3",
        "expression": "operations := [tuple(map(int, line.split())) for line in stdout.splitlines()[2:2+int(stdout.splitlines()[1])]]; all(1 <= i <= n and 1 <= j <= n and i != j for i, j in operations)",
        "description": "Each of the next k lines contains two distinct integers i and j (1 ≤ i, j ≤ n, i ≠ j) representing valid swap operations."
      },
      {
        "id": "Q4",
        "expression": "p_copy := p.copy(); total_coins := 0; for i, j in operations: p_copy[i-1], p_copy[j-1] = p_copy[j-1], p_copy[i-1]; total_coins += abs(i - j); total_coins == int(stdout.splitlines()[0]) and p_copy == s",
        "description": "The sequence of operations transforms p into s with the minimum total coins (sum of |i-j| for each swap)."
      }
    ],
    "invariants": []
