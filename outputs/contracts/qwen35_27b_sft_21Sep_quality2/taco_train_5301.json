  "contract": {
    "interface": {
      "mode": "stdin_stdout",
      "signature": "stdin -> stdout"
    },
    "preconditions": [
      {
        "id": "P1",
        "expression": "1 <= n <= 100000",
        "description": "The number of planets n must be between 1 and 100000."
      },
      {
        "id": "P2",
        "expression": "1 <= q <= 100000",
        "description": "The number of plans q must be between 1 and 100000."
      },
      {
        "id": "P3",
        "expression": "1 <= s <= n",
        "description": "The index of earth s must be between 1 and n."
      },
      {
        "id": "P4",
        "expression": "all(1 <= t <= 3 for t in plans)",
        "description": "Each plan type t must be 1, 2, or 3."
      },
      {
        "id": "P5",
        "expression": "all(1 <= v <= n and 1 <= u <= n and 1 <= w <= 10**9 for v, u, w in plans if t == 1)",
        "description": "For type 1 plans, v and u must be valid planet indices and w must be a valid cost."
      },
      {
        "id": "P6",
        "expression": "all(1 <= v <= n and 1 <= l <= r <= n and 1 <= w <= 10**9 for v, l, r, w in plans if t in (2, 3))",
        "description": "For type 2 and 3 plans, v must be a valid planet index, l and r must be valid ranges, and w must be a valid cost."
      }
    ],
    "postconditions": [
      {
        "id": "Q1",
        "expression": "len(stdout.split()) == n",
        "description": "The output must contain exactly n integers."
      },
      {
        "id": "Q2",
        "expression": "all(int(x) >= -1 for x in stdout.split())",
        "description": "Each output integer must be either a non-negative cost or -1."
      },
      {
        "id": "Q3",
        "expression": "stdout.split()[s-1] == '0'",
        "description": "The cost to reach the earth (planet s) must be 0."
      },
      {
        "id": "Q4",
        "expression": "all(int(stdout.split()[i]) == -1 or int(stdout.split()[i]) >= 0 for i in range(n))",
        "description": "For each planet, the output must indicate either the minimum cost or -1 if unreachable."
      }
    ],
    "invariants": []
  },
