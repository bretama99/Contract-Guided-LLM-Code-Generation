  "contract": {
    "interface": {
      "mode": "functional",
      "class_name": null,
      "function_name": "bear_fur",
      "signature": "bear_fur(bears: list[str]) -> str"
    },
    "preconditions": [
      {
        "id": "P1",
        "expression": "len(bears) == 2",
        "description": "The input list must contain exactly two elements."
      },
      {
        "id": "P2",
        "expression": "all(isinstance(bear, str) for bear in bears)",
        "description": "All elements in the input list must be strings."
      }
    ],
    "postconditions": [
      {
        "id": "Q1",
        "expression": "stdout in {'black', 'brown', 'white', 'dark brown', 'grey', 'light brown', 'unknown'}",
        "description": "The output must be one of the specified bear fur colors or 'unknown'."
      },
      {
        "id": "Q2",
        "expression": "stdout == 'black' if bears == ['black', 'black'] else True",
        "description": "If both bears are black, the offspring must be black."
      },
      {
        "id": "Q3",
        "expression": "stdout == 'brown' if bears == ['brown', 'brown'] else True",
        "description": "If both bears are brown, the offspring must be brown."
      },
      {
        "id": "Q4",
        "expression": "stdout == 'white' if bears == ['white', 'white'] else True",
        "description": "If both bears are white, the offspring must be white."
      },
      {
        "id": "Q5",
        "expression": "stdout == 'dark brown' if set(bears) == {'black', 'brown'} else True",
        "description": "If one bear is black and the other is brown, the offspring must be dark brown."
      },
      {
        "id": "Q6",
        "expression": "stdout == 'grey' if set(bears) == {'black', 'white'} else True",
        "description": "If one bear is black and the other is white, the offspring must be grey."
      },
      {
        "id": "Q7",
        "expression": "stdout == 'light brown' if set(bears) == {'brown', 'white'} else True",
        "description": "If one bear is brown and the other is white, the offspring must be light brown."
      },
      {
        "id": "Q8",
        "expression": "stdout == 'unknown' if any(bear not in {'black', 'brown', 'white'} for bear in bears) else True",
        "description": "If any bear is not black, brown, or white, the offspring must be unknown."
      }
    ],
    "invariants": []
  },
