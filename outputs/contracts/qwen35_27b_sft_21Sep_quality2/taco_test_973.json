        "expression": "all(isinstance(p, int) and p >= 0 for p in output)",
        "description": "Each integer in the output must be non-negative."
      },
      {
        "id": "Q3",
        "expression": "all(output[i] == count_pictures(museum, starting_positions[i]) for i in range(k))",
