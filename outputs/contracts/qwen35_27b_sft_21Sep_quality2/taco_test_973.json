      },
      {
        "id": "P4",
        "expression": "all(1 <= x <= n and 1 <= y <= m for x, y in starting_positions)",
        "description": "All starting positions must be within the bounds of the museum."
      }
    ],
    "postconditions": [
      {
        "id": "Q1",
        "expression": "len(output) == k",
        "description": "The output must contain exactly k integers."
      },
      {
