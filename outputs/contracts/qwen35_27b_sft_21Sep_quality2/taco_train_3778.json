  "contract": {
    "interface": {
      "mode": "stdin_stdout",
      "signature": "stdin -> stdout"
    },
    "preconditions": [
      {
        "id": "P1",
        "expression": "1 <= n <= 30000",
        "description": "The number of servers n must be between 1 and 30,000."
      },
      {
        "id": "P2",
        "expression": "len(rules) == 4 * n",
        "description": "There must be exactly 4n replication rules provided."
      },
      {
        "id": "P3",
        "expression": "all(1 <= a <= n and 1 <= b <= n and 1 <= c <= n for a, b, c in rules)",
        "description": "Each rule must reference valid server numbers between 1 and n."
      }
    ],
    "postconditions": [
      {
        "id": "Q1",
        "expression": "stdout == 'NO' or (stdout.startswith('YES') and len(stdout.split()) == 4 * n + 1)",
        "description": "If a valid order exists, output 'YES' followed by a permutation of rule indices; otherwise, output 'NO'."
      },
      {
        "id": "Q2",
        "expression": "all(1 <= int(rule) <= 4 * n for rule in stdout.split()[1:])",
        "description": "The output rule indices must be valid and within the range of 1 to 4n."
      },
      {
        "id": "Q3",
        "expression": "len(set(stdout.split()[1:])) == 4 * n",
        "description": "The output must contain each rule index exactly once."
      }
    ],
    "invariants": [
      {
        "id": "I1",
        "expression": "all(1 <= server_count <= 9 for server_count in server_counts)",
        "description": "At any point, the number of processes on each server must not exceed 9."
      },
      {
        "id": "I2",
        "expression": "sum(server_counts) == 4 * n + 2 * applied_rules",
        "description": "The total number of processes across all servers must equal the initial processes plus twice the number of applied rules."
      }
    ]
  },
