        "id": "P2",
        "expression": "1 <= len(P) <= 100000",
        "description": "The length of string P must be between 1 and 100,000."
      },
      {
        "id": "P3",
        "expression": "all(c.islower() for c in S) and all(c.islower() for c in P)",
        "description": "All characters in strings S and P must be lowercase alphabets."
      }
    ],
    "postconditions": [
      {
        "id": "Q1",
        "expression": "stdout == '-1' or (len(stdout) >= len(P) and all(c in stdout for c in P))",
        "description": "The output must be '-1' if no valid window exists, or a substring of S containing all characters of P."
      },
      {
        "id": "Q2",
        "expression": "len(stdout) == min(len(window) for window in valid_windows)",
        "description": "The output must be the smallest window containing all characters of P."
      },
      {
        "id": "Q3",
        "expression": "stdout == min(valid_windows, key=lambda x: (len(x), x))",
        "description": "If multiple windows of the same length exist, the output must be the one with the least starting index."
      }
    ],
    "invariants": []
