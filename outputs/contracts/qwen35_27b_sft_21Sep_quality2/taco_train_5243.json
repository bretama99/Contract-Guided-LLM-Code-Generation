  "contract": {
    "interface": {
      "mode": "stdin_stdout",
      "signature": "stdin -> stdout"
    },
    "preconditions": [
      {
        "id": "P1",
        "expression": "1 <= N <= 500000",
        "description": "The number of factories N must be between 1 and 500,000."
      },
      {
        "id": "P2",
        "expression": "1 <= M <= 500000",
        "description": "The number of businessmen M must be between 1 and 500,000."
      },
      {
        "id": "P3",
        "expression": "1 <= Q <= 500000",
        "description": "The number of years Q must be between 1 and 500,000."
      },
      {
        "id": "P4",
        "expression": "all(1 <= parent[i] <= i for i in range(1, N))",
        "description": "Each factory's parent must have a strictly lower index than the factory itself."
      },
      {
        "id": "P5",
        "expression": "all(1 <= B[i] <= M for i in range(1, N + 1))",
        "description": "Each factory must be owned by a valid businessman index."
      },
      {
        "id": "P6",
        "expression": "all(1 <= threshold[i] <= 10**18 for i in range(1, M + 1))",
        "description": "Each businessman's threshold must be between 1 and 10^18."
      },
      {
        "id": "P7",
        "expression": "all(1 <= F <= N and 1 <= X <= 10**6 and 0 <= D <= 10**6 for F, X, D in queries)",
        "description": "Each query must have valid factory index, donation amount, and dependency increment."
      }
    ],
    "postconditions": [
      {
        "id": "Q1",
        "expression": "all(stdout[i] == 'rekt' or 1 <= int(stdout[i]) <= Q for i in range(M))",
        "description": "Each output line must either be 'rekt' or a valid year number between 1 and Q."
      },
      {
        "id": "Q2",
        "expression": "all(int(stdout[i]) <= Q for i in range(M) if stdout[i] != 'rekt')",
        "description": "If a businessman earns the threshold, the year must be within the range of Q years."
      },
      {
        "id": "Q3",
        "expression": "all(int(stdout[i]) >= 1 for i in range(M) if stdout[i] != 'rekt')",
        "description": "If a businessman earns the threshold, the year must be at least 1."
      }
    ],
    "invariants": []
  },
