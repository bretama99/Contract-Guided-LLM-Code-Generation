  "contract": {
    "interface": {
      "mode": "functional",
      "class_name": null,
      "function_name": "bear_fur",
      "signature": "bear_fur(bears: List[str]) -> str"
    },
    "preconditions": [
      {
        "id": "P1",
        "expression": "len(bears) == 2",
        "description": "The input must be an array of exactly two elements."
      },
      {
        "id": "P2",
        "expression": "all(isinstance(bear, str) for bear in bears)",
        "description": "Both elements in the input array must be strings."
      },
      {
        "id": "P3",
        "expression": "bears[0] in ['black', 'brown', 'white'] and bears[1] in ['black', 'brown', 'white']",
        "description": "Both elements in the input array must be valid bear colors."
      }
    ],
    "postconditions": [
      {
        "id": "Q1",
        "expression": "stdout in ['black', 'brown', 'white', 'dark brown', 'grey', 'light brown', 'unknown']",
        "description": "The output must be one of the specified bear fur colors or 'unknown'."
      },
      {
        "id": "Q2",
        "expression": "(bears[0] == 'black' and bears[1] == 'black') == (stdout == 'black')",
        "description": "If both bears are black, the offspring must be black."
      },
      {
        "id": "Q3",
        "expression": "(bears[0] == 'brown' and bears[1] == 'brown') == (stdout == 'brown')",
        "description": "If both bears are brown, the offspring must be brown."
      },
      {
        "id": "Q4",
        "expression": "(bears[0] == 'white' and bears[1] == 'white') == (stdout == 'white')",
        "description": "If both bears are white, the offspring must be white."
      },
      {
        "id": "Q5",
        "expression": "(bears[0] == 'black' and bears[1] == 'brown') == (stdout == 'dark brown')",
        "description": "If one bear is black and the other is brown, the offspring must be dark brown."
      },
      {
        "id": "Q6",
        "expression": "(bears[0] == 'black' and bears[1] == 'white') == (stdout == 'grey')",
        "description": "If one bear is black and the other is white, the offspring must be grey."
      },
      {
        "id": "Q7",
        "expression": "(bears[0] == 'brown' and bears[1] == 'white') == (stdout == 'light brown')",
        "description": "If one bear is brown and the other is white, the offspring must be light brown."
      },
      {
        "id": "Q8",
        "expression": "any(bear not in ['black', 'brown', 'white'] for bear in bears) == (stdout == 'unknown')",
        "description": "If either bear is not a valid color, the offspring must be unknown."
      }
    ],
    "invariants": []
  },
