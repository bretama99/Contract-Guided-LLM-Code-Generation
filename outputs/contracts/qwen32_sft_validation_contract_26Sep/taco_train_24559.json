      "signature": "bus_timer(current_time: str) -> int"
    },
    "preconditions": [
      {
        "id": "P1",
        "expression": "isinstance(current_time, str)",
        "description": "The input current_time must be a string."
      },
      {
        "id": "P2",
        "expression": "len(current_time) == 5 and current_time[2] == ':'",
        "description": "The input current_time must be in the format 'HH:MM'."
      },
      {
        "id": "P3",
        "expression": "all(c.isdigit() for c in current_time if c != ':')",
        "description": "The input current_time must contain only digits except for the colon."
      }
    ],
    "postconditions": [
      {
        "id": "Q1",
        "expression": "stdout == 0 if current_time in ['06:00', '06:15', '06:30', '06:45'] else True",
        "description": "If the current time is exactly at a bus time, the output must be 0."
      },
      {
        "id": "Q2",
        "expression": "stdout >= 0 and stdout <= 14",
        "description": "The output must be a non-negative integer representing the minutes until the next bus, not exceeding 14."
      },
      {
        "id": "Q3",
        "expression": "stdout == 55 if current_time == '05:00' else True",
        "description": "If the current time is '05:00', the output must be 55."
      }
    ],
