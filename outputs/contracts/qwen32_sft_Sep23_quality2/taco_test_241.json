    "preconditions": [
      {
        "id": "P1",
        "expression": "1 <= T <= 10",
        "description": "The number of test cases T must be between 1 and 10."
      },
      {
        "id": "P2",
        "expression": "1 <= N <= 100000",
        "description": "The number of officers N must be between 1 and 100,000."
      },
      {
        "id": "P3",
        "expression": "1 <= C <= 1000000000",
        "description": "Chef's initial coordinate C must be between 1 and 1,000,000,000."
      },
      {
        "id": "P4",
        "expression": "all(1 <= P[i] <= 1000000000 for i in range(N))",
        "description": "All officer coordinates must be between 1 and 1,000,000,000."
      },
      {
        "id": "P5",
        "expression": "all(P[i] != C for i in range(N))",
        "description": "No officer can be at the same coordinate as Chef."
      },
      {
        "id": "P6",
        "expression": "len(set(P)) == N",
        "description": "All officer coordinates must be unique."
      }
    ],
    "postconditions": [
      {
        "id": "Q1",
        "expression": "stdout == f'{max_eliminated} {result}'",
        "description": "The output must contain the maximum number of officers eliminated and whether Chef runs away or is caught."
      },
      {
        "id": "Q2",
        "expression": "max_eliminated >= 0 and max_eliminated <= N",
        "description": "The maximum number of officers eliminated must be between 0 and N."
      },
      {
        "id": "Q3",
        "expression": "result in {1, -1}",
        "description": "The result must be 1 if Chef runs away, or -1 if Chef is caught."
      }
    ],
    "invariants": []
  },
