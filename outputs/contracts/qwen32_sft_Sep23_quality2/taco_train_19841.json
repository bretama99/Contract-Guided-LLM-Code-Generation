    "interface": {
      "mode": "stdin_stdout",
      "signature": "stdin -> stdout"
    },
    "preconditions": [
      {
        "id": "P1",
        "expression": "1 <= n <= 500000",
        "description": "The number of hashtags n must be between 1 and 500,000."
      },
      {
        "id": "P2",
        "expression": "all(len(hashtag) > 1 for hashtag in hashtags)",
        "description": "Each hashtag must have a length greater than 1, including the '#' character."
      },
      {
        "id": "P3",
        "expression": "sum(len(hashtag) - 1 for hashtag in hashtags) <= 500000",
        "description": "The total length of all hashtags (excluding the '#' character) must not exceed 500,000."
      }
    ],
    "postconditions": [
      {
        "id": "Q1",
        "expression": "all(hashtag.startswith('#') for hashtag in stdout)",
        "description": "Each resulting hashtag must start with the '#' character."
      },
      {
        "id": "Q2",
        "expression": "all(len(hashtag) <= len(original_hashtag) for hashtag, original_hashtag in zip(stdout, hashtags))",
        "description": "The length of each resulting hashtag must be less than or equal to the length of the corresponding original hashtag."
      },
      {
        "id": "Q3",
        "expression": "all(stdout[i] <= stdout[i + 1] for i in range(len(stdout) - 1))",
        "description": "The resulting hashtags must be in lexicographical order."
      }
    ],
    "invariants": []
  },
