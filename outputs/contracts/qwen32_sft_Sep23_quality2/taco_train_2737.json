    "preconditions": [
      {
        "id": "P1",
        "expression": "0 <= a",
        "description": "The number of zeroes a must be non-negative."
      },
      {
        "id": "P2",
        "expression": "1 <= b",
        "description": "The number of ones b must be at least one."
      },
      {
        "id": "P3",
        "expression": "0 <= k <= a + b",
        "description": "The number of ones k in the result must be between 0 and a + b."
      }
    ],
    "postconditions": [
      {
        "id": "Q1",
        "expression": "stdout == 'No' or (stdout.startswith('Yes') and len(stdout.split()) == 3)",
        "description": "The output must either be 'No' or 'Yes' followed by two binary integers x and y."
      },
      {
        "id": "Q2",
        "expression": "stdout.startswith('Yes') and (x := int(stdout.split()[1], 2)) >= (y := int(stdout.split()[2], 2))",
        "description": "If the output is 'Yes', x must be greater than or equal to y."
      },
      {
        "id": "Q3",
        "expression": "stdout.startswith('Yes') and bin(x - y).count('1') == k",
        "description": "If the output is 'Yes', the binary representation of x - y must have exactly k ones."
      }
    ],
    "invariants": []
  },
