      },
      {
        "id": "P2",
        "expression": "len(a) == 2**k",
        "description": "The length of the array a must be equal to 2^k."
      },
      {
        "id": "P3",
        "expression": "all(0 <= a_i < 2**k for a_i in a)",
        "description": "All elements of the array a must be non-negative integers less than 2^k."
      }
    ],
    "postconditions": [
      {
        "id": "Q1",
        "expression": "stdout == 'Fou' if not any(p_i ^ q_i == a_i for i in range(2**k)) else True",
        "description": "If no valid permutations p and q exist, output 'Fou'."
      },
      {
        "id": "Q2",
        "expression": "stdout == 'Shi' and len(set(p)) == 2**k and len(set(q)) == 2**k",
        "description": "If valid permutations p and q exist, output 'Shi' and ensure both p and q contain distinct integers from 0 to 2^k-1."
      },
      {
        "id": "Q3",
        "expression": "all(p[i] ^ q[i] == a[i] for i in range(2**k))",
        "description": "For all indices i, the XOR of p_i and q_i must equal a_i."
      }
    ],
