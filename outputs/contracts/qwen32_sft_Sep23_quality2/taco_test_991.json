      },
      {
        "id": "Q2",
        "expression": "len(edge_indices) == n - 1",
        "description": "The number of edges in the shortest-path tree must be n - 1."
      },
      {
        "id": "Q3",
        "expression": "all(1 <= index <= m for index in edge_indices)",
        "description": "All edge indices must be valid and within the range of the input edges."
      }
    ],
