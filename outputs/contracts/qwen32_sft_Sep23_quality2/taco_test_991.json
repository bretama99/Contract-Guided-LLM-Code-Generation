      },
      {
        "id": "P4",
        "expression": "1 <= u <= n",
        "description": "The start vertex u must be a valid vertex in the graph."
      }
    ],
    "postconditions": [
      {
        "id": "Q1",
        "expression": "stdout == str(min_total_weight) + '\\n' + ' '.join(map(str, edge_indices))",
