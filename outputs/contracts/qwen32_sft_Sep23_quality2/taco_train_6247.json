  "contract": {
    "interface": {
      "mode": "stdin_stdout",
      "signature": "stdin -> stdout"
    },
    "preconditions": [
      {
        "id": "P1",
        "expression": "1 <= n <= m <= 3000",
        "description": "The number of participants m and the number of top results n must satisfy 1 ≤ n ≤ m ≤ 3000."
      },
      {
        "id": "P2",
        "expression": "all(0 <= points[i] <= 2 * m for i in range(n))",
        "description": "Each of the n integers representing the points must be non-negative and not exceed 2 * m."
      },
      {
        "id": "P3",
        "expression": "len(points) == n",
        "description": "The number of points provided must exactly match the value of n."
      }
    ],
    "postconditions": [
      {
        "id": "Q1",
        "expression": "stdout == 'no' or (stdout.startswith('yes') and len(stdout.splitlines()) == m + 1)",
        "description": "The output must either be 'no' or start with 'yes' followed by m lines describing the tournament results."
      },
      {
        "id": "Q2",
        "expression": "all(stdout.splitlines()[i][i] == 'X' for i in range(m))",
        "description": "Each line of the tournament results must have 'X' on the main diagonal."
      },
      {
        "id": "Q3",
        "expression": "all(stdout.splitlines()[i][j] in {'W', 'D', 'L'} for i in range(m) for j in range(m) if i != j)",
        "description": "Each off-diagonal character in the tournament results must be 'W', 'D', or 'L'."
      }
    ],
    "invariants": []
  },
