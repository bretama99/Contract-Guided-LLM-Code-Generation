    "interface": {
      "mode": "stdin_stdout",
      "signature": "stdin -> stdout"
    },
    "preconditions": [
      {
        "id": "P1",
        "expression": "2 <= h <= 10**5",
        "description": "The height of the tree h must be between 2 and 100,000."
      },
      {
        "id": "P2",
        "expression": "all(1 <= a_i <= 2 * 10**5 for a_i in a) and len(a) == h + 1",
        "description": "Each element in the sequence a must be between 1 and 200,000, and the length of the sequence must be h + 1."
      },
      {
        "id": "P3",
        "expression": "sum(a) <= 2 * 10**5",
        "description": "The sum of all elements in the sequence a must not exceed 200,000."
      }
    ],
    "postconditions": [
      {
        "id": "Q1",
        "expression": "stdout == 'perfect'",
        "description": "If there is only one tree matching the sequence, the output must be 'perfect'."
      },
      {
        "id": "Q2",
        "expression": "stdout.startswith('ambiguous') and len(stdout.splitlines()) == 3",
        "description": "If there are multiple trees matching the sequence, the output must start with 'ambiguous' and contain two additional lines describing the trees."
      },
      {
        "id": "Q3",
        "expression": "all(int(parent) in range(len(a)) for parent in stdout.splitlines()[1].split()) and all(int(parent) in range(len(a)) for parent in stdout.splitlines()[2].split())",
        "description": "The parent indices in the output must be valid and within the range of the number of vertices."
      }
    ],
    "invariants": []
  },
