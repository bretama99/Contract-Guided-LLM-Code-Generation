    "interface": {
      "mode": "stdin_stdout",
      "signature": "stdin -> stdout"
    },
    "preconditions": [
      {
        "id": "P1",
        "expression": "1 <= t <= 10**4",
        "description": "The number of test cases t must be between 1 and 10,000."
      },
      {
        "id": "P2",
        "expression": "1 <= k < n <= 2 * 10**5",
        "description": "The number of rooms n must be between 1 and 200,000, and the number of friends k must be less than n."
      },
      {
        "id": "P3",
        "expression": "all(2 <= x_i <= n for x_i in x)",
        "description": "Each friend's room number x_i must be between 2 and n, and all x_i must be distinct."
      },
      {
        "id": "P4",
        "expression": "len(x) == k",
        "description": "The number of friends k must match the length of the list of room numbers x."
      },
      {
        "id": "P5",
        "expression": "all(1 <= u_j <= n and 1 <= v_j <= n for u_j, v_j in corridors)",
        "description": "Each corridor must connect two valid room numbers between 1 and n."
      },
      {
        "id": "P6",
        "expression": "len(corridors) == n - 1",
        "description": "The number of corridors must be exactly n-1, forming a tree."
      }
    ],
    "postconditions": [
      {
        "id": "Q1",
        "expression": "stdout == '-1' if vlad_wins else str(min_friends)",
        "description": "If Vlad wins, output '-1'; otherwise, output the minimum number of friends required to catch Vlad."
      },
      {
        "id": "Q2",
        "expression": "min_friends >= 0",
        "description": "The minimum number of friends required must be non-negative."
      },
      {
        "id": "Q3",
        "expression": "min_friends <= k",
        "description": "The minimum number of friends required cannot exceed the total number of friends k."
      }
    ],
    "invariants": []
  },
