FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg \
    PYTHONPATH=/workspace \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TOKENIZERS_PARALLELISM=false \
    HF_HOME=/workspace/.cache/huggingface \
    MPLCONFIGDIR=/workspace/.cache/matplotlib \
    NLTK_DATA=/usr/local/share/nltk_data

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    make \
    git \
    curl \
    wget \
    ca-certificates \
    unzip \
    zip \
    tar \
    gzip \
    coreutils \
    findutils \
    procps \
    pkg-config \
    libsndfile1 \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    tesseract-ocr \
    tk \
    tcl \
    tk8.6 \
    tcl8.6 \
    libtk8.6 \
    libtcl8.6 \
    python3-tk \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip setuptools wheel

RUN python -m pip install --prefer-binary \
    numpy \
    pandas \
    matplotlib \
    seaborn \
    scipy \
    scikit-learn \
    datasets \
    evalplus \
    requests \
    requests-mock \
    beautifulsoup4 \
    lxml \
    pillow \
    cryptography \
    python-dotenv \
    openai \
    anthropic \
    google-genai \
    tqdm \
    PyYAML \
    regex \
    python-dateutil \
    pytz \
    psutil \
    nltk \
    wordcloud \
    wikipedia \
    django \
    flask \
    Flask-RESTful \
    Flask-Login \
    Flask-Mail \
    Flask-WTF \
    WTForms \
    networkx \
    sympy \
    opencv-python-headless \
    faker \
    statsmodels \
    rsa \
    pycryptodome \
    openpyxl \
    python-docx \
    xlrd \
    xlwt \
    xmltodict \
    textblob \
    texttable \
    prettytable \
    natsort \
    geopy \
    holidays \
    mechanize \
    pyquery \
    wordninja \
    python-Levenshtein \
    blake3 \
    chardet \
    soundfile \
    librosa \
    pytesseract \
    folium \
    sendgrid \
    python-http-client \
    scikit-image \
    gensim \
    pyfakefs \
    shapely \
    geopandas \
    tensorflow-cpu \
    keras

RUN mkdir -p /workspace/.cache/huggingface /workspace/.cache/matplotlib "$NLTK_DATA" && \
    python - <<'PY'
import os
import nltk

nltk_data = os.environ.get("NLTK_DATA", "/usr/local/share/nltk_data")

for package in (
    "punkt",
    "punkt_tab",
    "stopwords",
    "wordnet",
    "omw-1.4",
    "averaged_perceptron_tagger",
    "averaged_perceptron_tagger_eng",
):
    nltk.download(package, download_dir=nltk_data, quiet=True)
PY

CMD ["/bin/bash"]
